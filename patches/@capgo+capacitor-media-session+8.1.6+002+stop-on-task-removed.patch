+    // Without this, swiping the app away from the recents/"running apps"
+    // screen does nothing - this foreground service (and the process it
+    // keeps alive, native audio player included) survives task removal
+    // by design, same as it survives an Activity recreation. That's
+    // correct for a real backgrounding (Home button), but a user swiping
+    // the task away is a clear "stop" signal, same as Spotify/YouTube
+    // Music treat it.
+    //
+    // stopForeground()+stopSelf() alone stops THIS service, but by then
+    // the Activity/WebView is already gone (task removal destroys it
+    // immediately) - any attempt to reach the native audio player
+    // through the JS bridge (plugin.actionCallback("stop")) would
+    // silently no-op since there's no bridge left to deliver it to, and
+    // Android doesn't guarantee reclaiming the rest of the now-serviceless
+    // process right away. Killing the process directly guarantees the
+    // player actually stops immediately rather than "eventually, maybe" -
+    // acceptable here since there's nothing left in this process the user
+    // could still be looking at once its one screen's task is gone.
+    @Override
+    public void onTaskRemoved(Intent rootIntent) {
+        destroy();
+        super.onTaskRemoved(rootIntent);
+        android.os.Process.killProcess(android.os.Process.myPid());
+    }
